{
  "name": "maison-luxury-commerce",
  "version": "0.1.0",
  "private": true,
  "description": "Custom luxury fashion e-commerce platform (placeholder brand: MAISON).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "db:generate": "prisma generate",
