# ─────────────────────────────────────────────────────────────
#  MAISON — Environment variables (copy to .env.local, never commit)
# ─────────────────────────────────────────────────────────────

# Core
NODE_ENV=development
APP_URL=http://localhost:3000
BRAND_NAME=MAISON

# Database (PostgreSQL) — Neon/Supabase/RDS/local
DATABASE_URL="postgresql://user:password@localhost:5432/maison?schema=public"

# Auth.js (NextAuth v5)
AUTH_SECRET="generate-with:  openssl rand -base64 32"
AUTH_URL=http://localhost:3000

# Stripe (server secret + webhook secret NEVER exposed to client)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Email (Resend)
RESEND_API_KEY=re_xxx
EMAIL_FROM="MAISON <no-reply@example.com>"

# Image CDN (Cloudinary example; or configure S3 in lib/media)
CLOUDINARY_URL=cloudinary://key:secret@cloud-name

# Analytics (optional — leave blank to disable)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Monitoring (optional)
SENTRY_DSN=
